# Copy to `.env` next to docker-compose.yml / docker-compose-prod.yml, then
# `docker compose up -d`. Compose reads this file automatically; exported shell
# variables are NOT inherited by `sudo docker compose` or dashboard deploys.
#
# Leave empty to accept any origin (origin check bypassed). Set it whenever the
# browser reaches the API from another origin - a UI on a different hostname, a
# Vite dev server on your LAN, etc. Non-browser clients (curl, Android, Postman)
# send no `Origin` and are never affected.
#
# Full origins only: scheme + host + port, comma-separated, no trailing slash.
#   http  for the Vite dev server, https for a hosted UI.
ALLOWED_ORIGIN=http://localhost:5173

# Host address and port to publish on (prod compose only).
# BIND_HOST=127.0.0.1
# PUBLISHED_PORT=8080
