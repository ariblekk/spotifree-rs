# syntax=docker/dockerfile:1
#
# Full image: Rust API + the Vite UI served by the same binary (same origin, no
# CORS). Use this when you want one container behind one hostname.
#
# Building the API alone? Use `Dockerfile` instead.

FROM node:22-alpine AS web

WORKDIR /web

COPY web/package.json web/package-lock.json ./
RUN npm ci --no-fund --no-audit

COPY web/ ./
RUN npm run build

FROM rust:1-alpine AS build

RUN apk add --no-cache musl-dev
WORKDIR /app

COPY Cargo.toml Cargo.lock ./
RUN mkdir -p src/bin && \
    echo 'fn main() {}' > src/main.rs && \
    echo 'pub fn stub() {}' > src/lib.rs && \
    echo 'fn main() {}' > src/bin/serve.rs && \
    cargo build --release --bin serve

COPY src ./src
RUN touch src/lib.rs src/bin/serve.rs && cargo build --release --bin serve

FROM alpine:3.20

RUN apk add --no-cache ca-certificates && \
    adduser -D -H -u 10001 app

COPY --from=build /app/target/release/serve /usr/local/bin/serve
COPY --from=web /web/dist /app/web/dist

USER app
ENV PORT=8080
ENV FRONTEND_DIR=/app/web/dist
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- "http://127.0.0.1:${PORT}/healthz" >/dev/null || exit 1

ENTRYPOINT ["/usr/local/bin/serve"]
